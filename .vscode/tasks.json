{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: create venv and install requirements",
      "type": "shell",
      "command": "python -m venv .venv; .venv/Scripts/python -m pip install --upgrade pip; .venv/Scripts/python -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Seed database",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/seed.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Run web server (auto-reload)",
      "type": "shell",
      "command": ".venv/Scripts/python -m uvicorn bongo_ai.app:app --port 8765 --reload --env-file .env",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": ".venv/Scripts/python -m pytest -q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
