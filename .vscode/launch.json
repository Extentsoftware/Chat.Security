{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bongo AI: web server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["bongo_ai.app:app", "--port", "8765"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Bongo AI: web server (offline, no LLM)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["bongo_ai.app:app", "--port", "8765"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "BONGO_LLM_PROVIDER": "offline" },
      "justMyCode": true
    },
    {
      "name": "Seed database (re-dated)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Seed database (original 2025 dates)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed.py",
      "args": ["--keep-dates"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "tests"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
