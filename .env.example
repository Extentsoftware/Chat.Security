# Copy to .env (git-ignored). VS Code (launch configs, terminals, tests) and the
# "Run web server" task load it. Uncomment what you need.

# --- LLM option A: Azure AI Foundry (takes priority when all three are set)
# Endpoint: the resource URL from the Foundry portal, e.g.
#   https://my-resource.cognitiveservices.azure.com      (GPT deployment, host only is fine)
#   https://my-resource.openai.azure.com/openai/v1         (GPT deployment, full v1 URL)
#   https://my-resource.services.ai.azure.com/anthropic   (Claude deployment)
# BONGO_FOUNDRY_ENDPOINT=
# BONGO_FOUNDRY_DEPLOYMENT=
# BONGO_FOUNDRY_API_KEY=
# BONGO_FOUNDRY_API=openai                # only if auto-detect is wrong: openai | anthropic

# --- LLM option B: direct API key; with nothing set, chat runs offline and the Tool console still works
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# BONGO_LLM_PROVIDER=foundry            # foundry | anthropic | openai | offline (default: whichever key is set)
# BONGO_ANTHROPIC_MODEL=claude-opus-5-5
# BONGO_ANTHROPIC_EFFORT=medium
# BONGO_OPENAI_MODEL=gpt-5

# --- Tokens: a fixed key keeps you signed in across server restarts.
# Without it a random key is made at startup and every restart signs everyone out.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# BONGO_JWT_KEY=
# BONGO_TOKEN_MINUTES=120

# --- Data
# BONGO_DEMO_PASSWORD=BongoDemo!2026     # read by scripts/seed.py
# BONGO_DB=data/bongo_demo.db
# BONGO_WEATHER_ONLINE=1                 # 0 = no calls to open-meteo.com
